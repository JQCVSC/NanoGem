# GEMINI_API_KEY: Required for Gemini AI API calls (kept on server; never passed into the sandbox container).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server bind address and port.
# Defaults to loopback (127.0.0.1). Binding to a non-loopback address (e.g. 0.0.0.0)
# is refused unless NANOGEM_API_TOKEN is configured with at least 16 characters.
HOST="127.0.0.1"
PORT="3000"

# API bearer token for /api/* endpoints (required when HOST is non-loopback; optional for loopback).
# Generate with: openssl rand -hex 32
NANOGEM_API_TOKEN=""

# Sandbox execution mode:
# - "docker" (default): Executes all terminal/agent commands inside hardened ephemeral Docker containers.
# - "host": Explicit opt-in to execute commands directly on the host without Docker isolation (unsafe).
NANOGEM_EXECUTION_MODE="docker"

# Hardened Docker sandbox configuration (used when NANOGEM_EXECUTION_MODE=docker).
NANOGEM_DOCKER_IMAGE="nanogem-sandbox:latest"
NANOGEM_DOCKER_USER="1000:1000"
NANOGEM_DOCKER_NETWORK="none"
NANOGEM_DOCKER_CPUS="1.0"
NANOGEM_DOCKER_MEMORY="512m"
NANOGEM_DOCKER_PIDS_LIMIT="64"
NANOGEM_DOCKER_READ_ONLY="true"
NANOGEM_COMMAND_TIMEOUT_MS="30000"

# APP_URL: The URL where this application is hosted.
APP_URL="http://127.0.0.1:3000"
